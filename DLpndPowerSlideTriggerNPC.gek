scn DLpndPowerSlideTriggerNPC

begin function { ref rTarget, ref rStarter }
  if eval ((rTarget != PlayerRef) && (rStarter == PlayerRef))
    CallForSeconds 5 (begin function {}
      if eval ((rTarget.GetDistance3D rStarter =< 100) && (rTarget.GetLineOfSight rStarter))
        DispatchEventAlt "DLpndPowerSlideHandler" rTarget
      endif
    end)
  endif
end