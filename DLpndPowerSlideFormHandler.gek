scn DLpndPowerSlideFormHandler

; Things here are responsible to apply effects to actors that were knocked over
begin function { ref rActorRef ref rContactedRef }
  rActorRef.PushActorAway rContactedRef (rActorRef.AuxVarGetFLT "*KnockForce")

  if eval (!(rActorRef.HasPerk Ninja) && (rActorRef.HasPerk WildWasteland))
    rContactedRef.StartCombat rActorRef
  endif

  if eval ((rActorRef.HasPerk Pyromaniac) && (rActorRef.HasPerk WildWasteland && rActorRef.AuxVarGetFLT "*PerkPyroEnable"))
    rContactedRef.CIOS FlamerCritEffect02
  endif

  if eval ((rActorRef.HasPerk ConcentratedFire) && (rActorRef.HasPerk WildWasteland))
    rContactedRef.CrippleLimb (GetRandomInRange 0 6)
  endif
end
